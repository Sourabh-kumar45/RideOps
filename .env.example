# Neon Postgres connection string (required).
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# The dataset ends on 30 Sep 2026; by default the app clock continues from there
# so new activity lines up with history (see DEMO_CLOCK in server/config.ts).
# Set to "off" to use the real date.
# DEMO_CLOCK=off

# Port for `npm run dev` / `npm start` (Next.js default is 3000).
# PORT=3000
